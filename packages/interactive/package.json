{
  "name": "@fuma-cli/interactive",
  "version": "0.1.3",
  "description": "Pre-built interactive interface for Fuma CLI",
  "keywords": [],
  "homepage": "https://cli.fuma-nama.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fuma-cli",
  "files": [
    "dist/*"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --config-loader unrun",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "fuma-cli": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "fuma-cli": "workspace:*",
    "tsdown": "0.23.0",
    "vitest": "^5.0.1"
  }
}

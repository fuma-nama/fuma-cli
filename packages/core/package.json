{
  "name": "fuma-cli",
  "version": "0.1.0",
  "description": "Build your own Shadcn CLI",
  "keywords": [],
  "homepage": "https://cli.fuma-nama.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fuma-cli",
  "files": [
    "dist/*"
  ],
  "type": "module",
  "exports": {
    "./compiler": "./dist/compiler/index.js",
    "./detect": "./dist/detect.js",
    "./macros/route-handler": "./dist/macros/route-handler.js",
    "./protocols/import": "./dist/protocols/import.js",
    "./registry/connector": "./dist/registry/connector.js",
    "./registry/installer": "./dist/registry/installer/index.js",
    "./registry/schema": "./dist/registry/schema.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --config-loader unrun",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.128.0",
    "oxc-resolver": "^11.19.1",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@oxc-project/types": "^0.128.0",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.6.0",
    "package-manager-detector": "^1.6.0",
    "tsdown": "0.21.10",
    "vitest": "^4.1.5"
  },
  "inlinedDependencies": {
    "package-manager-detector": "1.6.0"
  }
}

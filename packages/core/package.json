{
  "name": "fuma-cli",
  "version": "0.3.3",
  "description": "Build your own Shadcn CLI",
  "keywords": [],
  "homepage": "https://cli.fuma-nama.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fuma-cli",
  "files": [
    "dist/*"
  ],
  "type": "module",
  "exports": {
    "./compiler": "./dist/compiler/index.js",
    "./detect": "./dist/detect.js",
    "./macros/route-handler": "./dist/macros/route-handler.js",
    "./registry/connector": "./dist/registry/connector.js",
    "./registry/installer": "./dist/registry/installer/index.js",
    "./registry/schema": "./dist/registry/schema.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --config-loader unrun",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "magic-string": "^1.4.1",
    "oxc-resolver": "^11.24.2",
    "package-manager-detector": "^1.9.0",
    "picomatch": "^4.0.7",
    "tinyexec": "^1.3.1",
    "yuku-analyzer": "^0.19.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@ttsc/unplugin": "^0.36.3",
    "@types/node": "26.6.6",
    "@types/picomatch": "^4.0.3",
    "@yuku-toolchain/types": "^0.19.0",
    "tsdown": "0.23.7",
    "ttsc": "^0.36.3",
    "typescript": "7.0.2",
    "typia": "^15.3.0",
    "vitest": "^5.1.0"
  },
  "inlinedDependencies": {
    "typia": "15.3.0"
  }
}
